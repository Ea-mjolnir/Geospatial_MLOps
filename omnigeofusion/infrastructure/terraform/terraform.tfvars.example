# ================================================================
# OmniGeoFusion — Terraform Variables Example
# ================================================================
# 1. Copy this file:
#    cp terraform.tfvars.example terraform.tfvars
#
# 2. Fill in real values
# 3. terraform.tfvars is in .gitignore — never committed
# ================================================================

aws_region        = "us-east-1"
project_name      = "omnigeofusion"
environment       = "dev"

# RDS PostgreSQL password (min 8 chars)
db_password       = "your-secure-password-here"

# SSH public key (run: cat ~/.ssh/id_rsa.pub)
ec2_public_key    = "ssh-rsa AAAA..."

# Email for budget + CloudWatch alerts
alert_email       = "your-email@example.com"

# EKS settings
eks_node_type     = "t3.medium"
eks_min_nodes     = 1
eks_max_nodes     = 3

# EC2 settings
ec2_instance_type = "t3.medium"
